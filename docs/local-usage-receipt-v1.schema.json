{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meow-ops.local/schemas/local-usage-receipt-v1.json",
  "title": "Meow Ops Local Usage Receipt v1",
  "description": "Sanitized invocation evidence. 0 is valid only when the source recorded 0. Missing data is available=false with no value. Do not infer tokens, model, session, or cost. Do not write a derived total. Importers must never coerce missing to 0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "machine_id", "exported_at", "events"],
  "properties": {
    "schema_version": { "const": "local-usage-receipt.v1", "maxLength": 32 },
    "kind": { "const": "meow-ops.local-usage-receipt", "maxLength": 40 },
    "machine_id": {
      "type": "string",
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "exported_at": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/definitions/event" }
    }
  },
  "definitions": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "availabilityState": {
      "type": "string",
      "maxLength": 16,
      "enum": ["exact", "source", "partial", "count", "names", "unavailable"]
    },
    "tokenQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "value": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "provenance": { "const": "source", "maxLength": 8 }
      },
      "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
      "then": { "required": ["available", "value", "provenance"] },
      "else": {
        "allOf": [
          { "not": { "required": ["value"] } },
          { "not": { "required": ["provenance"] } }
        ]
      }
    },
    "moneyQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" },
        "value": { "type": "number", "minimum": 0, "maximum": 1000000000 },
        "provenance": { "const": "source", "maxLength": 8 }
      },
      "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
      "then": { "required": ["available", "value", "provenance"] },
      "else": {
        "allOf": [
          { "not": { "required": ["value"] } },
          { "not": { "required": ["provenance"] } }
        ]
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id", "dedupe_key", "harness", "model", "availability", "provenance"],
      "properties": {
        "source_event_id": { "$ref": "#/definitions/opaqueId" },
        "dedupe_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "harness": { "$ref": "#/definitions/safeId" },
        "runtime": {
          "oneOf": [{ "$ref": "#/definitions/safeId" }, { "type": "null" }]
        },
        "provider": {
          "oneOf": [{ "$ref": "#/definitions/safeId" }, { "type": "null" }]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!\\/|[A-Za-z]:[\\\\/]|\\\\\\\\|https?:\\/\\/)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "session_id": {
          "oneOf": [{ "$ref": "#/definitions/opaqueId" }, { "type": "null" }]
        },
        "started_at": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
            },
            { "type": "null" }
          ]
        },
        "ended_at": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 30,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
            },
            { "type": "null" }
          ]
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": { "$ref": "#/definitions/tokenQuantity" },
            "output": { "$ref": "#/definitions/tokenQuantity" },
            "cache_read": { "$ref": "#/definitions/tokenQuantity" },
            "cache_write": { "$ref": "#/definitions/tokenQuantity" },
            "reasoning": { "$ref": "#/definitions/tokenQuantity" },
            "total": { "$ref": "#/definitions/tokenQuantity" }
          }
        },
        "cost_usd": { "$ref": "#/definitions/moneyQuantity" },
        "tool_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "names": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            }
          },
          "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
          "then": { "anyOf": [{ "required": ["count"] }, { "required": ["names"] }] },
          "else": {
            "allOf": [
              { "not": { "required": ["count"] } },
              { "not": { "required": ["names"] } }
            ]
          }
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "runtime", "provider", "session", "tokens", "cost", "tool_calls"],
          "properties": {
            "model": { "const": "exact", "maxLength": 8 },
            "runtime": { "$ref": "#/definitions/availabilityState" },
            "provider": { "$ref": "#/definitions/availabilityState" },
            "session": { "$ref": "#/definitions/availabilityState" },
            "tokens": { "$ref": "#/definitions/availabilityState" },
            "cost": { "$ref": "#/definitions/availabilityState" },
            "tool_calls": { "$ref": "#/definitions/availabilityState" }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_kind", "source_label", "recorded_as"],
          "properties": {
            "source_kind": {
              "type": "string",
              "maxLength": 16,
              "enum": ["sqlite", "jsonl", "json", "markdown", "api-response", "receipt"]
            },
            "source_label": { "$ref": "#/definitions/safeId" },
            "schema_pin": { "$ref": "#/definitions/safeId" },
            "recorded_as": { "const": "invocation", "maxLength": 16 }
          },
          "if": { "properties": { "source_kind": { "const": "sqlite" } }, "required": ["source_kind"] },
          "then": { "required": ["schema_pin"] }
        }
      }
    }
  }
}
